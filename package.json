{
  "name": "goobercraft",
  "version": "0.1.7",
  "description": "Mineflayer'dan bağımsız TypeScript Minecraft Java Edition bot kütüphanesi. minecraft-protocol ve prismarine ekosistemi üzerine kuruludur.",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "ts-node src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "minecraft-data": "^3.78.0",
    "minecraft-protocol": "^1.66.2",
    "prismarine-block": "^1.23.0",
    "prismarine-chunk": "^1.40.0",
    "prismarine-item": "^1.18.0",
    "prismarine-nbt": "^2.8.0",
    "prismarine-registry": "^1.12.0",
    "prismarine-world": "^3.7.0",
    "vec3": "^0.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}